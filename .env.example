# Copy to .env.local and fill in. Never commit real keys.

# Required: set ONE of these.
# Google AI Studio key (uses Gemini models directly)
GOOGLE_GENERATIVE_AI_API_KEY=
# Vercel AI Gateway key (used when no Google key is set)
AI_GATEWAY_API_KEY=

# Optional: override the models used by /api/recommend
# Defaults: Gemini -> gemini-2.5-flash / gemini-2.5-flash-lite
#           Gateway -> anthropic/claude-sonnet-5.5 / anthropic/claude-haiku-5.5
RECOMMENDER_MODEL=
RECOMMENDER_FALLBACK_MODEL=

# Optional: Reddit search proxy (default: https://api.pullpush.io/reddit/search)
PULLPUSH_BASE_URL=
